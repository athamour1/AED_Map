# Copy to .env.prod next to docker-compose.prod.yml. Never commit the real file.
# Use with: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

# Image tag to deploy (a release tag like v1.2.0, or latest).
TAG=latest

POSTGRES_USER=aedmap
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs access tokens (~15min JWTs). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# The real origin browsers will use (scheme + domain, no trailing slash).
APP_ORIGIN=https://your-domain.example

# Where the gateway listens on the host. Keep 127.0.0.1 when your reverse
# proxy runs on the same machine; 0.0.0.0 only if it runs elsewhere.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
